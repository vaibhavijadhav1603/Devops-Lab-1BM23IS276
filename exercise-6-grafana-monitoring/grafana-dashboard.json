{
  "dashboard": {
    "uid": "delivery-monitoring",
    "title": "Delivery Monitoring Dashboard",
    "refresh": "5s",
    "time": { "from": "now-15m", "to": "now" },
    "schemaVersion": 39,
    "panels": [
      {
        "id": 1,
        "title": "Total Deliveries",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [ { "refId": "A", "expr": "total_deliveries", "legendFormat": "total_deliveries" } ]
      },
      {
        "id": 2,
        "title": "Pending Deliveries",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [ { "refId": "A", "expr": "pending_deliveries", "legendFormat": "pending_deliveries" } ]
      },
      {
        "id": 3,
        "title": "On-the-Way Deliveries",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [ { "refId": "A", "expr": "on_the_way_deliveries", "legendFormat": "on_the_way_deliveries" } ]
      },
      {
        "id": 4,
        "title": "Average Delivery Time (seconds)",
        "type": "timeseries",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "targets": [ { "refId": "A", "expr": "average_delivery_time_sum / average_delivery_time_count", "legendFormat": "average delivery time" } ]
      }
    ]
  },
  "overwrite": true
}
